{
  "name": "@sumi-os/docs-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for Markdown, MDX, and OpenAPI documentation.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starSumi/sumi-docs.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/starSumi/sumi-docs/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/starSumi/sumi-docs/issues"
  },
  "engines": {
    "node": ">=25.5.0"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "bin": {
    "sumi-docs-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "tsx src/index.ts serve examples/basic/docs --openapi examples/basic/openapi.json --verbose",
    "dev:watch": "tsx watch src/index.ts serve examples/basic/docs --openapi examples/basic/openapi.json --verbose",
    "preview:docs": "node scripts/preview-docs.js",
    "start": "node dist/index.js serve examples/basic/docs --openapi examples/basic/openapi.json",
    "build": "node scripts/clean-dist.js && tsc && node scripts/post-build.js",
    "build:sea-bundle": "node --run build && node scripts/build-sea-bundle.js",
    "build:sea": "node --run build:sea-bundle && node scripts/build-sea.js",
    "benchmark:cold-start": "node scripts/benchmark-cold-start.js",
    "example:smoke": "node --run build && node scripts/smoke-example.js",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:watch": "node --import tsx --test --watch tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests --deny-warnings",
    "lint:staged": "lint-staged --fail-on-changes",
    "commitlint": "commitlint",
    "test:git-hooks": "node scripts/git-hooks/test-gates.mjs",
    "verify": "node --run lint && node --run typecheck && node --run test && node --run test:git-hooks",
    "audit:prod": "node ../../scripts/run-pnpm-command.mjs audit --prod --audit-level high --registry https://registry.npmjs.org",
    "verify:push": "node --run verify && node --run audit:prod",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "node -e \"const fs=require('node:fs'); for (const path of ['dist','.sea','artifacts','sea-prep.blob']) fs.rmSync(path,{recursive:true,force:true})\"",
    "prepack": "node --run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "documentation",
    "ai-native",
    "llm",
    "markdown",
    "openapi",
    "stateless",
    "agent"
  ],
  "author": "Sumi OS",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@sumi-os/corpus-contract": "workspace:*",
    "mdast-util-to-string": "^4.0.0",
    "minimist": "^1.2.8",
    "remark": "^15.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-strip-html": "^1.0.2",
    "unified": "^11.0.4",
    "yaml": "^2.4.5",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/mdast": "^4.0.4",
    "@types/minimist": "^1.2.5",
    "@types/node": "^25.9.5",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --deny-warnings",
      "prettier --check"
    ],
    "*.{js,mjs,cjs,json,md,mdx,yaml,yml}": "prettier --check"
  },
  "files": [
    "dist",
    "docs/architecture.md",
    "docs/README.md",
    "docs/decisions/0001-astro-starlight-dual-surface.md",
    "docs/decisions/0002-polyrepo-and-package-manager.md",
    "docs/decisions/0003-localized-content-projection.md",
    "docs/decisions/0004-authoritative-repository-initialization.md",
    "docs/decisions/0005-project-discovery-and-local-state-placement.md",
    "docs/decisions/0006-immutable-content-projection.md",
    "docs/decisions/0007-native-agent-host-integration.md",
    "docs/decisions/0008-product-workspace-topology.md",
    "docs/decisions/0009-reconciliation-and-control-plane-state.md",
    "docs/decisions/0010-runtime-migration-gate.md",
    "docs/decisions/0011-calibrated-cold-start-policy.md",
    "docs/decisions/0012-dual-transport-and-address-model.md",
    "docs/decisions/0013-standards-and-schema-authority.md",
    "docs/decisions/0014-single-build-dual-target-publication.md",
    "docs/configuration.md",
    "docs/contributing.md",
    "docs/development.md",
    "docs/git-workflow.md",
    "docs/getting-started.md",
    "docs/releasing.md",
    "docs/remote-sources.md",
    "docs/skills-and-orchestration.md",
    "docs/troubleshooting.md",
    "docs/tool-reference.md",
    "examples",
    "scripts/preview-docs.js",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ]
}
